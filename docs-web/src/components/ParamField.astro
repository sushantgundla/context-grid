---
// Mintlify's parameter row: the name, its type, and an optional default, above the prose.
// 167 uses across the docs, so this is the component the migration actually rests on.
const { path, type, default: fallback } = Astro.props
---
<div class="field">
  <p class="field-head">
    <code class="field-name">{path}</code>
    {type && <span class="field-type">{type}</span>}
    {fallback !== undefined && (
      <span class="field-default">default: <code>{fallback}</code></span>
    )}
  </p>
  <div class="field-body"><slot /></div>
</div>

<style>
  .field {
    border-top: 1px solid var(--sl-color-hairline);
    padding: 0.85rem 0;
  }
  .field-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
  }
  .field-name {
    font-weight: 600;
    background: none;
    padding: 0;
    color: var(--sl-color-white);
  }
  .field-type {
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-text-accent);
  }
  .field-default {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .field-default code {
    background: none;
    padding: 0;
    font-size: inherit;
  }
  /* The prose under a field is secondary to the field itself, so it sits tighter than body text. */
  .field-body :global(> :first-child) { margin-top: 0.35rem; }
  .field-body :global(> :last-child) { margin-bottom: 0; }
</style>
