---
const { title } = Astro.props
---
<div class="step">
  <p class="step-title">{title}</p>
  <div class="step-body"><slot /></div>
</div>

<style>
  .step {
    position: relative;
    padding: 0 0 1.4rem 2.4rem;
    border-inline-start: 1px solid var(--sl-color-hairline-light);
    margin-inline-start: 0.9rem;
  }
  .step:last-child { border-inline-start-color: transparent; padding-bottom: 0; }
  .step::before {
    counter-increment: step;
    content: counter(step);
    position: absolute;
    inset-inline-start: -0.9rem;
    top: -0.15rem;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--sl-color-text-accent);
    background: color-mix(in srgb, var(--sl-color-accent) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 35%, transparent);
    box-shadow: 0 0 0 4px var(--sl-color-bg);
  }
  .step-title {
    font-weight: 620;
    font-size: 0.98rem;
    color: var(--sl-color-white);
    margin: 0.15rem 0 0.45rem;
    letter-spacing: -0.01em;
  }
  .step-body :global(> :last-child) { margin-bottom: 0; }
</style>
