---
// A disclosure, using <details> so it works with no JavaScript and stays keyboard-accessible.
// The chevron is Starlight's own `summary::before` -- it already rotates on open, and drawing
// a second one here only ever produced two chevrons side by side.
const { title } = Astro.props
---
<details class="accordion">
  <summary>
    {title}
  </summary>
  <div class="accordion-body"><slot /></div>
</details>

<style>
  .accordion {
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.6rem;
    padding: 0.15rem 0.9rem;
    margin: 0.8rem 0;
    background: var(--cg-surface);
    transition: border-color 0.15s ease;
  }
  .accordion:hover { border-color: var(--sl-color-gray-4); }
  summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    padding: 0.65rem 0;
    font-weight: 600;
    font-size: 0.94rem;
    color: var(--sl-color-white);
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  .accordion-body {
    padding-bottom: 0.85rem;
    font-size: 0.94rem;
    color: var(--sl-color-gray-2);
  }
  .accordion-body :global(> :first-child) { margin-top: 0; }
  .accordion-body :global(> :last-child) { margin-bottom: 0; }
</style>
