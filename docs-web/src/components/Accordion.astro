---
// A disclosure, using <details> so it works with no JavaScript and stays keyboard-accessible.
const { title } = Astro.props
---
<details class="accordion">
  <summary>{title}</summary>
  <div class="accordion-body"><slot /></div>
</details>

<style>
  .accordion {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    padding: 0.6rem 0.9rem;
    margin: 0.75rem 0;
    background: var(--sl-color-black);
  }
  summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .accordion[open] > summary { margin-bottom: 0.6rem; }
  .accordion-body :global(> :last-child) { margin-bottom: 0; }
</style>
