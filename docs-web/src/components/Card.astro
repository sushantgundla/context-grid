---
// Mintlify names icons from Font Awesome. Only three appear anywhere in these docs, so they are
// drawn here rather than pulling in an icon package for three glyphs; anything else renders
// without an icon instead of breaking the card.
const { title, icon, href } = Astro.props

const paths = {
  code: 'M8 3L3 8l5 5M12 3l5 5-5 5',
  flask: 'M7 2v5L3 15a2 2 0 0 0 2 3h10a2 2 0 0 0 2-3l-4-8V2M7 2h6M6.5 11h7',
  terminal: 'M3 4h14v12H3zM6 8l2.5 2L6 12M11 12h3',
}

// The rehype pass rebases links written in Markdown, but this href arrives as a component prop
// and never enters that tree, so it has to be rebased here or the card leaves the docs entirely.
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const isInternal = href?.startsWith('/') && !href.startsWith('//') && !href.startsWith(`${base}/`)
const resolved = isInternal ? base + href : href

const Tag = href ? 'a' : 'div'
---
<Tag class="card" href={resolved} data-linked={href ? '' : undefined}>
  {paths[icon] && (
    <span class="card-icon">
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d={paths[icon]} />
      </svg>
    </span>
  )}
  <p class="card-title">
    {title}
    {href && <span class="card-arrow" aria-hidden="true">→</span>}
  </p>
  <div class="card-body"><slot /></div>
</Tag>

<style>
  .card {
    display: block;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.75rem;
    padding: 1.1rem;
    background: var(--cg-surface);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  a.card:hover {
    border-color: color-mix(in srgb, var(--sl-color-accent) 55%, transparent);
    transform: translateY(-2px);
    box-shadow: var(--cg-shadow);
  }
  .card-icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
    margin-bottom: 0.7rem;
    color: var(--sl-color-text-accent);
    background: color-mix(in srgb, var(--sl-color-accent) 14%, transparent);
  }
  .card-icon svg { width: 1.1rem; height: 1.1rem; }
  .card-title {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 620;
    font-size: 0.98rem;
    color: var(--sl-color-white);
    margin: 0 0 0.35rem;
    letter-spacing: -0.01em;
  }
  /* The arrow slides on hover so a linked card reads as clickable before it is clicked. */
  .card-arrow {
    color: var(--sl-color-text-accent);
    transition: transform 0.15s ease;
  }
  a.card:hover .card-arrow { transform: translateX(3px); }
  .card-body {
    font-size: 0.9rem;
    color: var(--sl-color-gray-3);
    line-height: 1.6;
  }
  .card-body :global(> :first-child) { margin-top: 0; }
  .card-body :global(> :last-child) { margin-bottom: 0; }
</style>
