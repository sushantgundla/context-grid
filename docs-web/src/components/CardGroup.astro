---
// `cols` is 2 or 3 in these docs. It is a maximum, not a fixed count: the grid collapses to one
// column on a narrow screen rather than forcing a horizontal scroll.
const { cols = 2 } = Astro.props
---
<div class="card-group" style={`--cols: ${cols}`}><slot /></div>

<style>
  .card-group {
    display: grid;
    gap: 0.75rem;
    margin: 1rem 0;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
  }
  @media (max-width: 50rem) {
    .card-group { grid-template-columns: minmax(0, 1fr); }
  }
</style>
