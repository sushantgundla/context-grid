---
const { title } = Astro.props
---
<section class="tab">
  <p class="tab-title">{title}</p>
  <div class="tab-body"><slot /></div>
</section>

<style>
  .tab {
    border-top: 1px solid var(--sl-color-hairline);
    padding: 0.9rem 1.1rem;
  }
  .tab:first-child { border-top: none; }
  .tab-title {
    display: inline-block;
    font-family: var(--sl-font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--sl-color-text-accent);
    background: color-mix(in srgb, var(--sl-color-accent) 13%, transparent);
    padding: 0.2rem 0.45rem;
    border-radius: 0.3rem;
    margin: 0 0 0.6rem;
  }
  .tab-body :global(> :first-child) { margin-top: 0; }
  .tab-body :global(> :last-child) { margin-bottom: 0; }
</style>
