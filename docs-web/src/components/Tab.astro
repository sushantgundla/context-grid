---
const { title } = Astro.props
---
<section class="tab">
  <p class="tab-title">{title}</p>
  <div class="tab-body"><slot /></div>
</section>

<style>
  .tab { border-top: 1px solid var(--sl-color-gray-5); padding: 0.75rem 1rem; }
  .tab:first-child { border-top: none; }
  .tab-title {
    font-size: var(--sl-text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--sl-color-text-accent);
    margin: 0 0 0.5rem;
  }
  .tab-body :global(> :first-child) { margin-top: 0; }
  .tab-body :global(> :last-child) { margin-bottom: 0; }
</style>
